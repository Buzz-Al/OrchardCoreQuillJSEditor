@model Buzz.OrchardCore.Quilljs.ViewModels.QuillSettingsViewModel

<div id="@Html.IdFor(m => m)" class="field-editor field-editor-quill">

    <div class="mb-3">
        <label asp-for="Theme" class="form-label">@T["Theme"]</label>
        <select asp-for="Theme" asp-items="Html.GetEnumSelectList<QuillTheme>()" class="form-select"></select>
        <span class="hint">@T["Snow theme shows the toolbar at all times. Bubble theme shows toolbar on text selection."]</span>
    </div>

    <hr />

    <h5>@T["Toolbar Buttons"]</h5>
    <p class="text-muted">@T["Select which buttons to display in the editor toolbar"]</p>

    <div class="row">
        <!-- Formatting -->
        <div class="col-md-6 mb-3">
            <h6 class="text-muted">@T["Text Formatting"]</h6>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Bold" />
                <label class="form-check-label" asp-for="Bold">@T["Bold"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Italic" />
                <label class="form-check-label" asp-for="Italic">@T["Italic"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Underline" />
                <label class="form-check-label" asp-for="Underline">@T["Underline"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Strike" />
                <label class="form-check-label" asp-for="Strike">@T["Strikethrough"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Code" />
                <label class="form-check-label" asp-for="Code">@T["Inline Code"]</label>
            </div>
        </div>

        <!-- Blocks -->
        <div class="col-md-6 mb-3">
            <h6 class="text-muted">@T["Blocks"]</h6>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Blockquote" />
                <label class="form-check-label" asp-for="Blockquote">@T["Blockquote"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="CodeBlock" />
                <label class="form-check-label" asp-for="CodeBlock">@T["Code Block"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Header1" />
                <label class="form-check-label" asp-for="Header1">@T["Header 1"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Header2" />
                <label class="form-check-label" asp-for="Header2">@T["Header 2"]</label>
            </div>
        </div>

        <!-- Lists -->
        <div class="col-md-6 mb-3">
            <h6 class="text-muted">@T["Lists"]</h6>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="OrderedList" />
                <label class="form-check-label" asp-for="OrderedList">@T["Numbered List"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="BulletList" />
                <label class="form-check-label" asp-for="BulletList">@T["Bullet List"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="CheckList" />
                <label class="form-check-label" asp-for="CheckList">@T["Checklist"]</label>
            </div>
        </div>

        <!-- Media -->
        <div class="col-md-6 mb-3">
            <h6 class="text-muted">@T["Media"]</h6>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Link" />
                <label class="form-check-label" asp-for="Link">@T["Link"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Image" />
                <label class="form-check-label" asp-for="Image">@T["Image"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Video" />
                <label class="form-check-label" asp-for="Video">@T["Video"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Formula" />
                <label class="form-check-label" asp-for="Formula">@T["Formula"]</label>
            </div>
        </div>

        <!-- Styles -->
        <div class="col-md-6 mb-3">
            <h6 class="text-muted">@T["Styles"]</h6>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Color" />
                <label class="form-check-label" asp-for="Color">@T["Text Color"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Background" />
                <label class="form-check-label" asp-for="Background">@T["Background Color"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Font" />
                <label class="form-check-label" asp-for="Font">@T["Font Family"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Size" />
                <label class="form-check-label" asp-for="Size">@T["Font Size"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Align" />
                <label class="form-check-label" asp-for="Align">@T["Text Alignment"]</label>
            </div>
        </div>

        <!-- Advanced -->
        <div class="col-md-6 mb-3">
            <h6 class="text-muted">@T["Advanced"]</h6>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Script" />
                <label class="form-check-label" asp-for="Script">@T["Superscript / Subscript"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Indent" />
                <label class="form-check-label" asp-for="Indent">@T["Indent / Outdent"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Direction" />
                <label class="form-check-label" asp-for="Direction">@T["Text Direction (RTL)"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="Clean" />
                <label class="form-check-label" asp-for="Clean">@T["Remove Formatting"]</label>
            </div>
        </div>
    </div>

    <hr />

    <!-- Custom Colors -->
    <div class="mb-4">
        <h5 class="mb-2">@T["Custom Color Palette"]</h5>
        <p class="text-muted small mb-3">@T["Define custom colors for the text color and background color pickers. Leave empty to use theme defaults."]</p>

        <div id="color-palette-editor" class="card">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold small text-uppercase text-muted mb-2">@T["Add New Color"]</label>
                    <div class="input-group" style="max-width: 300px;">
                        <input type="color" id="new-color-input" class="form-control form-control-color" value="#000000" title="@T["Choose color"]" style="width: 56px;" />
                        <button type="button" class="btn btn-primary" id="add-color-btn">
                            <i class="fa-solid fa-plus me-1"></i>@T["Add Color"]
                        </button>
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label fw-semibold small text-uppercase text-muted">@T["Color Palette"]</label>
                </div>
                <div id="color-list" class="d-flex flex-wrap gap-2 p-3 bg-light rounded-3 min-vh-auto" style="min-height: 60px;">
                    @for (int i = 0; i < Model.CustomColors.Count; i++)
                    {
                        <div class="color-item d-inline-flex align-items-center bg-white border rounded-pill shadow-sm px-2 py-1" data-color="@Model.CustomColors[i]" style="transition: all 0.2s ease;">
                            <input type="hidden" asp-for="CustomColors[i]" />
                            <div class="color-preview me-2 rounded-circle shadow-sm" style="width: 32px; height: 32px; background-color: @Model.CustomColors[i]; border: 2px solid #fff; box-shadow: 0 0 0 1px rgba(0,0,0,0.1);"></div>
                            <span class="me-2 font-monospace fw-semibold text-dark" style="font-size: 0.875rem;">@Model.CustomColors[i]</span>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-circle remove-color-btn ms-1" style="width: 24px; height: 24px; padding: 0; line-height: 1;" title="@T["Remove color"]">
                                <i class="fa-solid fa-xmark" style="font-size: 0.75rem;"></i>
                            </button>
                        </div>
                    }
                </div>
                @if (Model.CustomColors.Count == 0)
                {
                    <div id="empty-state" class="text-center text-muted py-4">
                        <i class="fa-solid fa-palette fa-2x mb-2 opacity-25"></i>
                        <p class="mb-0 small">@T["No custom colors added yet. Add colors using the picker above."]</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script at="Foot">
    (function() {
        // Color palette management
        const colorList = document.getElementById('color-list');
        const addColorBtn = document.getElementById('add-color-btn');
        const newColorInput = document.getElementById('new-color-input');

        // Get the field name prefix from existing hidden input (if any)
        const existingInput = colorList.querySelector('input[type="hidden"]');
        let fieldNamePrefix = '';
        if (existingInput) {
            fieldNamePrefix = existingInput.name.substring(0, existingInput.name.lastIndexOf('[') + 1);
        } else {
            @{
                var fieldName = Html.NameFor(m => m.CustomColors).ToString();
            }
            fieldNamePrefix = '@fieldName' + '[';
        }

        addColorBtn.addEventListener('click', function() {
            const color = newColorInput.value;
            addColorToList(color);
            hideEmptyState();
        });

        function addColorToList(color) {
            const currentIndex = colorList.querySelectorAll('.color-item').length;
            const colorItem = document.createElement('div');
            colorItem.className = 'color-item d-inline-flex align-items-center bg-white border rounded-pill shadow-sm px-2 py-1';
            colorItem.style.cssText = 'transition: all 0.2s ease;';
            colorItem.setAttribute('data-color', color);

            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.name = fieldNamePrefix + currentIndex + ']';
            hiddenInput.value = color;

            const preview = document.createElement('div');
            preview.className = 'color-preview me-2 rounded-circle shadow-sm';
            preview.style.cssText = 'width: 32px; height: 32px; background-color: ' + color + '; border: 2px solid #fff; box-shadow: 0 0 0 1px rgba(0,0,0,0.1);';

            const colorText = document.createElement('span');
            colorText.className = 'me-2 font-monospace fw-semibold text-dark';
            colorText.style.fontSize = '0.875rem';
            colorText.textContent = color;

            const removeBtn = document.createElement('button');
            removeBtn.type = 'button';
            removeBtn.className = 'btn btn-sm btn-outline-danger rounded-circle remove-color-btn ms-1';
            removeBtn.style.cssText = 'width: 24px; height: 24px; padding: 0; line-height: 1;';
            removeBtn.title = '@T["Remove color"]';
            removeBtn.innerHTML = '<i class="fa-solid fa-xmark" style="font-size: 0.75rem;"></i>';

            colorItem.appendChild(hiddenInput);
            colorItem.appendChild(preview);
            colorItem.appendChild(colorText);
            colorItem.appendChild(removeBtn);
            colorList.appendChild(colorItem);
        }

        function hideEmptyState() {
            const emptyState = document.getElementById('empty-state');
            if (emptyState) {
                emptyState.style.display = 'none';
            }
        }

        function showEmptyState() {
            const emptyState = document.getElementById('empty-state');
            if (emptyState && colorList.querySelectorAll('.color-item').length === 0) {
                emptyState.style.display = 'block';
            }
        }

        // Remove color button handler (event delegation)
        colorList.addEventListener('click', function(e) {
            // Handle clicks on button or icon inside button
            const removeBtn = e.target.closest('.remove-color-btn');
            if (removeBtn) {
                removeBtn.closest('.color-item').remove();
                reindexColors();
                showEmptyState();
            }
        });

        // Re-index all color inputs to maintain consecutive indexes (required for ASP.NET Core list binding)
        function reindexColors() {
            const colorItems = colorList.querySelectorAll('.color-item');
            colorItems.forEach((item, index) => {
                const input = item.querySelector('input[type="hidden"]');
                input.name = `${fieldNamePrefix}${index}]`;
            });
        }

        // Initialize: hide empty state if colors exist
        if (colorList.querySelectorAll('.color-item').length > 0) {
            hideEmptyState();
        }
    })();
</script>
